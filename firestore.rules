rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Existing owner-only state access is preserved.
    match /stepUsers/{uid}/states/{stateId} {
      allow read, write: if signedInAs(uid);

      // Recovery history is only valid below the canonical main state.
      match /history/{historyId} {
        allow read, write: if signedInAs(uid) && stateId == "main";
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
